# ariel-site-admin-skills: copy to ~/.config/ariel-admin/.env and fill in.
# The CLI loads this file first; a variable already set in the shell wins.

# Door 1: the Convex deployment's ADMIN_API_SECRET (required for query / mutate / overview / analytics / upload / content-*).
# In the site repo: npx convex env get ADMIN_API_SECRET --prod
ARIEL_ADMIN_API_SECRET=

# Door 2: the admin panel password (ADMIN_PASSWORD in Vercel). Needed for login / act / export-* / record-voice only.
ARIEL_ADMIN_PASSWORD=

# Optional overrides.
# ARIEL_CONVEX_URL=https://affable-kiwi-408.eu-west-1.convex.cloud
# ARIEL_CONVEX_URL_DEV=https://moonlit-shepherd-589.eu-west-1.convex.cloud
# ARIEL_SITE_URL=https://arielaizenshtat-site.vercel.app
# ARIEL_SITE_REPO=/Users/a1234/ariel aizenshtat-website
# ARIEL_ADMIN_COOKIE_JAR=~/.cache/ariel-admin/cookies.txt
